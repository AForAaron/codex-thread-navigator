{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "packages/plugin/**/*.ts",
    "packages/preview/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vendor"
  ]
}
